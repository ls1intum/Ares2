    - {static} isArchitectureInput(file: Path): boolean
    - {static} updateAnalysisInputDigest(digest: MessageDigest, relativePath: Path, file: Path): void
    + getCallGraph(classPath: String): CallGraph
    - {static} convertToJavaArchunitTestCase(testCase: JavaArchitectureTestCase): JavaArchunitTestCase
    - {static} convertToJavaWalaTestCases(testCase: JavaArchitectureTestCase): JavaWalaTestCase
    - {static} convertToJavaArchunitTestCases(testCases: List<JavaArchitectureTestCase>): List<JavaArchunitTestCase>
    - {static} convertToJavaWalaTestCases(testCases: List<JavaArchitectureTestCase>): List<JavaWalaTestCase>
  }

  abstract class ArchitectureTestCase {
    # allowedPackages: Set<PackagePermission>
    # javaClasses: JavaClasses
    # callGraph: CallGraph
    # ArchitectureTestCase(architectureTestCaseSupported: ArchitectureTestCaseSupported, ...): ArchitectureTestCase
    + getArchitectureTestCaseSupported(): ArchitectureTestCaseSupported
    + getAllowedPackages(): Set<PackagePermission>
    + getJavaClasses(): JavaClasses
    + getCallGraph(): CallGraph
    + {abstract} writeArchitectureTestCase(architectureMode: String, aopMode: String): String
    + {abstract} executeArchitectureTestCase(architectureMode: String, aopMode: String): void
  }

  note left of ArchitectureTestCase
    architectureTestCaseSupported: nonnull
    - allowed: exactly one supported architecture test
    allowedPackages: nonnull
    - allowed: exhaustive permitted-package set
    javaClasses: nonnull
    - allowed: imported classes under test
    callGraph: nullable
    - allowed: WALA call graph
  end note

  interface ArchitectureTestCaseSupported {
    + getStatic(): List<ArchitectureTestCaseSupported>
    + getDynamic(): List<ArchitectureTestCaseSupported>
  }
}

