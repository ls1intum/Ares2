    + requireClassPath(field: String, value: String): void
}

note top of JavaNameRules
      INSTANCE: nonnull
      - allowed: shared stateless singleton
      PACKAGE_PATTERN: nonnull
      - regex: Java package name
      TYPE_NAME_PATTERN: nonnull
      - regex: Java type name
      CLASS_PATH_PATTERN: nonnull
      - regex: Java class path
      THREAD_CONSTRUCT_PATTERN: nonnull
      - regex: Java class | "Lambda-Expression" | recognised implicit operation | "*"
end note

